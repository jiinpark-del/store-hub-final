# Node Environment
NODE_ENV=production

# Database Configuration
DB_HOST=postgres
DB_PORT=5432
DB_NAME=store_hub
DB_USER=postgres
DB_PASSWORD=change_me_in_production

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379

# API Configuration
API_URL=http://localhost:3000
VITE_API_URL=http://localhost:3000

# JWT Configuration
JWT_SECRET=your-very-secure-jwt-secret-key-change-in-production

# OCR Configuration
OCR_API_KEY=your-google-vision-api-key
TESSERACT_LANG=eng

# Server Configuration
PORT=3000
HOST=0.0.0.0

# Logging
LOG_LEVEL=info

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=1000
